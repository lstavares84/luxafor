{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }],
    "PreToolUse":       [{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }],
    "PostToolUse":      [{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }],
    "PermissionRequest":[{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }],
    "Notification": [
      { "matcher": "permission_prompt|idle_prompt|elicitation_dialog|elicitation_url_dialog|agent_needs_input|quota_auto_resume_fired|quota_auto_resume_disabled",
        "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }
    ],
    "Stop":        [{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 5 }] }],
    "SessionEnd":  [{ "hooks": [{ "type": "command", "command": "signa-cli", "args": ["hook", "claude-code"], "timeout": 2 }] }]
  }
}
